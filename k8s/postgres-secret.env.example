# Plantilla del Secret de PostgreSQL (este archivo se versiona; no contiene datos reales).
# Copie este archivo como k8s/postgres-secret.env y cambie la contrasena.
# k8s/postgres-secret.env esta en .gitignore y NUNCA se sube a Git.
# Los scripts deploy-minikube.ps1 / .sh lo crean con una contrasena aleatoria si no existe.
POSTGRES_DB=hipoteca_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
